#!/usr/bin/env bash
# ac-page — create pages from templates, read/update frontmatter. JSON on stdout.
#   ac-page new <template> <dest.md> --title <T> [--topic <t>] [--raw-path <p>]
#                [--status draft|final] [--classification C0|C1|C2|C3]
#   ac-page meta <file.md>          frontmatter as JSON
#   ac-page touch <file.md>         set updated: to today
#   ac-page promote <src.md> <dest.md>   move a draft out of drafts/, set status: final, touch updated:
#   ac-page archive <src.md> <dest.md>   move an item into archive/, set status: archived, touch updated:
#   ac-page classify <file.md> <C0|C1|C2|C3> [--ack-floor]
#                    set classification, restamp classified-hash, touch updated:
#                    --ack-floor additionally stamps classification-ack: (a
#                    USER-only decision — see CONTENT.md's Classification
#                    section); without it any standing ack is withdrawn
set -euo pipefail
export AC_CMD="${1:-}"; shift || true
python3 - "$@" <<'PYEOF'
import sys, os, json, re, datetime, hashlib

TPL_DIR = ".agentic-cms/templates"
TODAY = datetime.date.today().isoformat()
LEVELS = ("C0", "C1", "C2", "C3")

def fail(msg):
    print(json.dumps({"ok": False, "error": msg})); sys.exit(1)

def read_fm(path):
    text = open(path, encoding="utf-8").read()
    m = re.match(r"^---\n(.*?)\n---\n", text, re.S)
    if not m:
        return None, text
    fm = {}
    for line in m.group(1).splitlines():
        km = re.match(r"^(\w[\w-]*):\s*(.*)$", line)
        if km:
            v = km.group(2).strip()
            if v.startswith("[") and v.endswith("]"):
                v = [x.strip() for x in v[1:-1].split(",") if x.strip()]
            fm[km.group(1)] = v
    return fm, text

def body_of(text):
    # Everything after the frontmatter's closing "---" — what classified-hash covers.
    m = re.match(r"^---\n.*?\n---\n", text, re.S)
    return text[m.end():] if m else text

def content_hash(body):
    return hashlib.sha256(body.strip().encode("utf-8")).hexdigest()[:12]

cmd = os.environ.get("AC_CMD", "")
args = sys.argv[1:]

if cmd == "new":
    if len(args) < 2: fail("usage: ac-page new <template> <dest.md> --title <T> [--topic <t>] [--raw-path <p>] [--status draft|final] [--classification C0|C1|C2|C3]")
    tpl_name, dest = args[0], args[1]
    opts = {}
    it = iter(args[2:])
    for a in it:
        if a.startswith("--"):
            opts[a[2:]] = next(it, "")
    if "title" not in opts: fail("--title is required")
    if opts.get("status", "final") not in ("draft", "final"): fail("--status must be draft or final")
    classification = opts.get("classification", "C1")
    if classification not in LEVELS: fail(f"--classification must be one of {LEVELS}")
    tpl = os.path.join(TPL_DIR, tpl_name + ".md")
    if not os.path.isfile(tpl): fail(f"template not found: {tpl}")
    if os.path.exists(dest): fail(f"refusing to overwrite existing file: {dest}")
    content = open(tpl, encoding="utf-8").read()
    slug = os.path.splitext(os.path.basename(dest))[0]
    subst = {
        "{{TITLE}}": opts["title"],
        "{{TOPIC}}": opts.get("topic", ""),
        "{{RAW_PATH}}": opts.get("raw-path", ""),
        "{{STATUS}}": opts.get("status", "final"),
        "{{CLASSIFICATION}}": classification,
        "{{DATE}}": TODAY,
    }
    for k, v in subst.items():
        content = content.replace(k, v)
    # Hash the body as it exists post-substitution (title/date already filled
    # in), so the stamped hash matches the page's actual initial content —
    # not a raw template with placeholders still in it.
    content = content.replace("{{CLASSIFIED_HASH}}", content_hash(body_of(content)))
    os.makedirs(os.path.dirname(dest) or ".", exist_ok=True)
    open(dest, "w", encoding="utf-8").write(content)
    print(json.dumps({"ok": True, "path": dest, "template": tpl_name, "title": opts["title"],
                      "slug": slug, "classification": classification}))

elif cmd == "classify":
    # --ack-floor stamps a classification-ack: bound to the same body hash as
    # classified-hash. It records a USER decision ("I reviewed this floor hit
    # and keep this rating") — agents must never pass it on their own
    # judgment, only relay an explicit user instruction. Any body change
    # invalidates the ack together with the hash.
    ack_floor = "--ack-floor" in args
    args = [a for a in args if a != "--ack-floor"]
    if len(args) != 2: fail("usage: ac-page classify <file.md> <C0|C1|C2|C3> [--ack-floor]")
    path, level = args
    if level not in LEVELS: fail(f"level must be one of {LEVELS}")
    if not os.path.isfile(path): fail(f"no such file: {path}")
    fm, text = read_fm(path)
    if fm is None: fail(f"no frontmatter in {path}")
    if "classification" in fm:
        text = re.sub(r"^classification:.*$", f"classification: {level}", text, count=1, flags=re.M)
    else:
        text = re.sub(r"\n---\n", f"\nclassification: {level}\n---\n", text, count=1)
    new_hash = content_hash(body_of(text))
    if "classified-hash" in fm or re.search(r"^classified-hash:", text, re.M):
        text = re.sub(r"^classified-hash:.*$", f"classified-hash: {new_hash}", text, count=1, flags=re.M)
    else:
        text = re.sub(r"\n---\n", f"\nclassified-hash: {new_hash}\n---\n", text, count=1)
    if ack_floor:
        if re.search(r"^classification-ack:", text, re.M):
            text = re.sub(r"^classification-ack:.*$", f"classification-ack: {new_hash}", text, count=1, flags=re.M)
        else:
            text = re.sub(r"\n---\n", f"\nclassification-ack: {new_hash}\n---\n", text, count=1)
    else:
        # A plain re-rate withdraws any standing ack: the rating decision was
        # just re-made, so a leftover ack no longer represents current intent.
        text = re.sub(r"^classification-ack:.*\n", "", text, count=1, flags=re.M)
    text = re.sub(r"^(updated:).*$", rf"\1 {TODAY}", text, count=1, flags=re.M)
    open(path, "w", encoding="utf-8").write(text)
    out = {"ok": True, "path": path, "classification": level,
           "classified-hash": new_hash, "updated": TODAY}
    if ack_floor:
        out["classification-ack"] = new_hash
    print(json.dumps(out))

elif cmd in ("promote", "archive"):
    if len(args) != 2: fail(f"usage: ac-page {cmd} <src.md> <dest.md>")
    src, dest = args
    status = "final" if cmd == "promote" else "archived"
    if not os.path.isfile(src): fail(f"no such file: {src}")
    if os.path.exists(dest): fail(f"refusing to overwrite existing file: {dest}")
    fm, text = read_fm(src)
    if fm is None: fail(f"no frontmatter in {src}")
    if "status" in fm:
        text = re.sub(r"^status:.*$", f"status: {status}", text, count=1, flags=re.M)
    else:
        # Absent status means final; an archived page must carry it explicitly.
        text = re.sub(r"\n---\n", f"\nstatus: {status}\n---\n", text, count=1)
    text = re.sub(r"^(updated:).*$", rf"\1 {TODAY}", text, count=1, flags=re.M)
    os.makedirs(os.path.dirname(dest) or ".", exist_ok=True)
    open(dest, "w", encoding="utf-8").write(text)
    os.remove(src)
    print(json.dumps({"ok": True, "path": dest, "from": src, "status": status, "updated": TODAY}))

elif cmd == "meta":
    if len(args) != 1: fail("usage: ac-page meta <file.md>")
    if not os.path.isfile(args[0]): fail(f"no such file: {args[0]}")
    fm, _ = read_fm(args[0])
    if fm is None: fail(f"no frontmatter in {args[0]}")
    print(json.dumps({"ok": True, "path": args[0], "frontmatter": fm}))

elif cmd == "touch":
    if len(args) != 1: fail("usage: ac-page touch <file.md>")
    if not os.path.isfile(args[0]): fail(f"no such file: {args[0]}")
    fm, text = read_fm(args[0])
    if fm is None: fail(f"no frontmatter in {args[0]}")
    new = re.sub(r"^(updated:).*$", rf"\1 {TODAY}", text, count=1, flags=re.M)
    open(args[0], "w", encoding="utf-8").write(new)
    print(json.dumps({"ok": True, "path": args[0], "updated": TODAY}))

else:
    fail("usage: ac-page new|meta|touch|promote|archive|classify")
PYEOF
